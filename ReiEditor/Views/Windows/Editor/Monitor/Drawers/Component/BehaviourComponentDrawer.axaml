<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers.Components"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.Component.BehaviourComponentDrawer"
             x:DataType="components:BehaviourComponentDrawerViewModel">
    <Design.DataContext>
        <components:BehaviourComponentDrawerViewModel />
    </Design.DataContext>

    <Border Classes="MonitorComponent">

        <Grid RowDefinitions="Auto, *">
            <TextBlock
                Padding="10, 0, 0, 0"
                Text="{Binding Name}" />

            <Border Grid.Row="1" MinHeight="10"
                    Margin="0,10,0,0"
                    BorderBrush="{StaticResource Gray_0}"
                    BorderThickness="0, 1, 0, 0">

            </Border>

        </Grid>

    </Border>
</UserControl>