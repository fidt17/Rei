<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:drawers="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers"
             xmlns:property="clr-namespace:ReiEditor.Views.Windows.Editor.Monitor.Drawers.Property"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.DataAssetMonitorDrawer"
             x:DataType="drawers:DataAssetMonitorDrawerViewModel">
    <Design.DataContext>
        <drawers:DataAssetMonitorDrawerViewModel />
    </Design.DataContext>

    <Border Padding="10">
        <StackPanel Spacing="8">
            <TextBlock Classes="h4" Text="{Binding AssetName}" />
            <TextBlock Text="{Binding AssetIdLabel}" Foreground="{StaticResource Gray_2}" />
            <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Gray_2}" />

            <TextBlock IsVisible="{Binding !IsLoaded}"
                       Text="{Binding StatusText}"
                       Foreground="{StaticResource Gray_2}" />

            <StackPanel IsVisible="{Binding IsLoaded}" Spacing="8">
                <TextBlock IsVisible="{Binding !!StatusText}"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource Gray_2}" />
                <property:PropertiesDisplayControl Value="{Binding Properties}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
