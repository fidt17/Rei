<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contextMenu="clr-namespace:ReiEditor.Views.Controls.ContextMenu"
             xmlns:controls="clr-namespace:ReiEditor.ViewModels.Controls"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Controls.ContextMenu.ContextMenuView"
             x:DataType="controls:ContextMenuViewModel">
    <Design.DataContext>
        <controls:ContextMenuViewModel />
    </Design.DataContext>

    <Border Classes="Window" Margin="0">
        <ItemsControl ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <contextMenu:ContextMenuOptionView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
