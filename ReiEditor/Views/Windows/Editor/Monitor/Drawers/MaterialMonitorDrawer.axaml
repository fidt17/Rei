<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:drawers="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers"
             xmlns:assets="clr-namespace:ReiEditor.Views.Controls.Assets"
             xmlns:property="clr-namespace:ReiEditor.Views.Windows.Editor.Monitor.Drawers.Property"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.MaterialMonitorDrawer"
             x:DataType="drawers:MaterialMonitorDrawerViewModel">
    <Design.DataContext>
        <drawers:MaterialMonitorDrawerViewModel />
    </Design.DataContext>

    <Border Padding="10">
        <StackPanel Spacing="8">
            <TextBlock Classes="h4" Text="{Binding AssetName}" />
            <TextBlock Text="{Binding AssetIdLabel}" Foreground="{StaticResource Gray_2}" />

            <TextBlock IsVisible="{Binding !IsMaterialLoaded}"
                       Text="{Binding StatusText}"
                       Foreground="{StaticResource Gray_2}" />

            <StackPanel IsVisible="{Binding IsMaterialLoaded}" Spacing="8">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0"
                               Width="120"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource Gray_4}"
                               Text="Shader" />
                    <assets:AssetPickerView Grid.Column="1"
                                            DataContext="{Binding ShaderPicker}" />
                </Grid>

                <TextBlock IsVisible="{Binding !HasShaderProperties}"
                           Text="{Binding ShaderPropertiesStatusText}"
                           Foreground="{StaticResource Gray_2}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap" />

                <property:PropertiesDisplayControl IsVisible="{Binding HasShaderProperties}"
                                                   Value="{Binding ShaderProperties}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
