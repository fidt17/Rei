<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers.Property.Custom"
             xmlns:textBoxes="clr-namespace:ReiEditor.Views.Controls.TextBoxes"
             xmlns:picker="clr-namespace:ReiEditor.Views.Controls.ColorPicker"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.Property.Custom.ColorPropertyView"
             x:DataType="custom:ColorPropertyViewModel">

    <UserControl.Resources>
        <Flyout x:Key="ColorEditorFlyout"
                FlyoutPresenterClasses="Default">
            <StackPanel Spacing="8"
                        Width="330">
                <picker:ColorWheelPicker
                    Width="220"
                    Height="220"
                    HorizontalAlignment="Center"
                    Hue="{Binding H, Mode=TwoWay}"
                    Saturation="{Binding S, Mode=TwoWay}"
                    Brightness="{Binding V, Mode=TwoWay}" />

                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock
                        Text="Alpha"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Gray_4}" />
                    <Slider
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding A, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                    <TextBlock Text="R" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding R, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Margin="0,0,4,0" Text="G" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="3" Margin="0,0,6,0" Text="{Binding G, Mode=TwoWay}" />
                    <TextBlock Grid.Column="4" Margin="0,0,4,0" Text="B" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="5" Margin="0,0,6,0" Text="{Binding B, Mode=TwoWay}" />
                    <TextBlock Grid.Column="6" Margin="0,0,4,0" Text="A" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="7" Text="{Binding A, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                    <TextBlock Text="H" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding H, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Margin="0,0,4,0" Text="S" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="3" Margin="0,0,6,0" Text="{Binding S, Mode=TwoWay}" />
                    <TextBlock Grid.Column="4" Margin="0,0,4,0" Text="V" VerticalAlignment="Center" Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="5" Text="{Binding V, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Hex"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Gray_4}" />
                    <textBoxes:ReiTextBox Grid.Column="1"
                                          Text="{Binding Hex, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Flyout>
    </UserControl.Resources>

    <Design.DataContext>
        <custom:ColorPropertyViewModel />
    </Design.DataContext>

    <Border Padding="1">
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock
                Grid.Column="0"
                Width="95"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource Gray_4}"
                Text="{Binding PropertyName.Value}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
                <Button x:Name="HexButton"
                        Classes="Clear"
                        Height="26"
                        MinWidth="116"
                        Click="OpenEditorFlyout_OnClick">
                    <Border
                        Classes="asset-name"
                        Height="26"
                        VerticalAlignment="Center"
                        Background="{StaticResource Dark_3}"
                        BorderBrush="{StaticResource Gray_0}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource Gray_3}"
                            Text="{Binding Hex}" />
                    </Border>
                </Button>

                <Button x:Name="PreviewButton"
                        Width="30"
                        Height="26"
                        Classes="Clear"
                        Click="OpenEditorFlyout_OnClick">
                    <Border
                        Width="30"
                        Height="26"
                        CornerRadius="2"
                        BorderBrush="{StaticResource Gray_0}"
                        BorderThickness="1"
                        Background="{Binding PreviewBrush}">
                        <Grid RowDefinitions="*,4">
                            <Border Grid.Row="1"
                                    Background="Black" />
                            <Border Grid.Row="1"
                                    Background="White">
                                <Border.RenderTransformOrigin>0, 0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding A}" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
