#ifdef VERTEX
    layout (location = 0) in vec3 aPos;

    uniform mat4 model;
    uniform mat4 view;
    uniform mat4 projection;

    out vec3 FragPos;

    void main()
    {
       vec4 vm = view * model * vec4(aPos, 1.0);
       FragPos = vec3(vm);
       gl_Position = projection * vm;
    }
#endif

#ifdef FRAGMENT
    in vec3 FragPos;

    out vec4 FragColor;

    void main()
    {    
        FragColor = vec4(1, 0, 1, 1);
    }
#endif
