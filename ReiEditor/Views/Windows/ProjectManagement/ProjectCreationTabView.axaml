<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:projectManagement="clr-namespace:ReiEditor.ViewModels.Windows.ProjectManagement"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.ProjectManagement.ProjectCreationTabView"
             x:DataType="projectManagement:ProjectCreationTabViewModel"
             d:DesignWidth="550" d:DesignHeight="450"
             Background="{StaticResource Dark_0}">

    <Design.DataContext>
        <projectManagement:ProjectCreationTabViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20">
            <TextBlock Text="New Project" Classes="h1" />
        </Grid>

        <!-- Configuration -->
        <Border Grid.Row="1" Classes="Window" Margin="0">
            <Border Classes="WindowContent">
                <Grid RowDefinitions="Auto, *, Auto"
                      Margin="20">

                    <StackPanel Grid.Row="1"
                                Spacing="10">

                        <!-- Project Name -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="Project name" Classes="h4"></TextBlock>
                            <TextBox Name="ProjectNameTextBox"
                                     Classes.valid="{Binding Notifications.ProjectNameValid}"
                                     Text="{Binding ProjectName}">
                                <TextBox.Styles>
                                    <Style Selector="TextBox:not(.valid) /template/ Border#PART_BorderElement">
                                        <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                        </StackPanel>

                        <!-- Location -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="Location" Classes="h4"></TextBlock>
                            <Button Command="{Binding SelectProjectLocationCommand}"
                                    Classes.valid="{Binding Notifications.ProjectPathValid}"
                                    HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:not(.valid) /template/ ContentPresenter">
                                        <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                    </Style>
                                </Button.Styles>

                                <TextBlock
                                    Text="{Binding ProjectPath}" />
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- Controls -->
                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Project creation failed" Classes="h4" Foreground="{StaticResource Error}"
                                   IsVisible="{Binding Notifications.ProjectCreationFailed}"
                                   HorizontalAlignment="Center"
                                   Margin="40" />

                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Command="{Binding CancelProjectCreationCommand}">Cancel</Button>
                            <Button Command="{Binding CreateProjectCommand}">Create project</Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Border>
        </Border>
    </Grid>
</UserControl>