in vec3 _FragPos;
in vec3 _Normal;
in vec3 _PointLightPositions[NR_POINT_LIGHTS];
in vec2 _TexCoords;

out vec4 FragColor;

vec4 REI_CalculateAmbientLight()
{
    vec4 ambient = _AmbientLight.Strength * _AmbientLight.Color;
    ambient.a = 1;
    
    return ambient;
} 

vec4 REI_CalculatePointLight(float shininess)
{
    vec4 total;
    for (int i = 0; i < NR_POINT_LIGHTS; i++)
    {
        PointLight light = _PointLights[i];
        vec3 lightPosition = _PointLightPositions[i];
        
        // diffuse 
        vec3 norm = normalize(_Normal);
        vec3 lightDir = normalize(lightPosition - _FragPos);
        float diff = max(dot(norm, lightDir), 0.0);
        vec4 diffuse = diff * light.Color;
        
        // specular
        vec3 viewDir = normalize(-_FragPos);
        vec3 reflectDir = reflect(-lightDir, norm);  
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
        vec4 specular = spec * light.Color; 

        vec4 result = diffuse + specular;
        result.a = 1;

        total += result * light.Strength;
    }
    
    return total;
} 

vec4 REI_Sample(sampler2D sampler)
{
    return texture(sampler, _TexCoords);
}
