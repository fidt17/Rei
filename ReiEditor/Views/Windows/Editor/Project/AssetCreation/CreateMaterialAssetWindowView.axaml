<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Project.AssetCreation"
        xmlns:search="clr-namespace:ReiEditor.Views.Controls.SearchField"
        mc:Ignorable="d"
        Width="520"
        Height="500"
        MinWidth="500"
        MinHeight="420"
        x:Class="ReiEditor.Views.Windows.Editor.Project.AssetCreation.CreateMaterialAssetWindowView"
        x:DataType="vm:CreateMaterialAssetWindowViewModel"
        Title="Create Material"
        Icon="/Assets/Images/Rei Icon.png"
        Background="{StaticResource Dark_0}"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:CreateMaterialAssetWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Text="Create Material" Classes="h2" />

        <StackPanel Grid.Row="1" Margin="0,16,0,16" Spacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Name" />
                <TextBox Text="{Binding MaterialName}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Shader" />
                <TextBlock Text="{Binding SelectedShaderName}" Foreground="{StaticResource Gray_3}" />
                <search:SearchFieldView DataContext="{Binding SearchField}" />
                <Border BorderBrush="{StaticResource Gray_1}" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ShaderSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShaderAssetSearchItemViewModel">
                                    <Border Padding="6">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Text="{Binding Name}" />
                                            <Button Grid.Column="1" Content="Select" Command="{Binding SelectCommand}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding FullPath}"
                                                       Foreground="{StaticResource Gray_3}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <TextBlock Foreground="{StaticResource Error}"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorText}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Command="{Binding CreateCommand}" Content="Create" />
        </StackPanel>
    </Grid>
</Window>
