<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:playmode="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Playmode"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReiEditor.Views.Windows.Editor.Playmode.RenderModeSelectionView"
             x:DataType="playmode:RenderModeSelectionViewModel">

    <Design.DataContext>
        <playmode:RenderModeSelectionViewModel />
    </Design.DataContext>

    <ComboBox
        IsVisible="{Binding EngineActive}"
        MinWidth="100"
        SelectedValue="{Binding SelectedRenderMode, Mode=TwoWay}"
        ItemsSource="{Binding Options}" />
</UserControl>