<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:projectManagement="clr-namespace:ReiEditor.ViewModels.Windows.ProjectManagement"
             xmlns:contextMenu="clr-namespace:ReiEditor.Views.Controls.ContextMenu"
             mc:Ignorable="d"
             d:DesignWidth="400"
             x:Class="ReiEditor.Views.Windows.ProjectManagement.ProjectsListElementView"
             x:DataType="projectManagement:ProjectsListElementViewModel">
    <Design.DataContext>
        <projectManagement:ProjectsListElementViewModel />
    </Design.DataContext>

    <Grid>
        <Button
            HorizontalAlignment="Stretch"
            Command="{Binding OpenProjectCommand}">

            <Button.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.2" />
            </Button.Effect>

            <Grid ColumnDefinitions="*, 160">

                <StackPanel Grid.Column="0"
                            MinWidth="300">
                    <TextBlock Text="{Binding Project.ProjectName}" FontWeight="Black" />
                    <TextBlock Text="{Binding Project.ProjectFilePath}"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource Gray_3}" />
                </StackPanel>

                <!--
                <TextBlock Grid.Column="1"
                           Margin="0,0,20,0"
                           HorizontalAlignment="Right"
                           Text="{Binding Project.LastEditTime}"
                           Foreground="{StaticResource Gray_3}"
                           VerticalAlignment="Bottom" />
                           -->

                <!-- Context Menu Button -->
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    x:Name="ContextMenuButton"
                    Classes="Clear"
                    ToolTip.Tip="Project options">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="AutomationProperties.Name" Value="Project options" />
                        </Style>
                        <Style Selector="Button Image">
                            <Setter Property="Opacity" Value="0.55" />
                        </Style>
                        <Style Selector="Button#ContextMenuButton:pointerover Image">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </Button.Styles>
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="Clear">
                            <contextMenu:ContextMenuView DataContext="{Binding ContextMenu}" />
                        </Flyout>
                    </Button.Flyout>

                    <Image Classes="EditorIcon" RenderOptions.BitmapInterpolationMode="HighQuality" Source="/Assets/Icons/Lucide/ellipsis-vertical.png" />
                </Button>
            </Grid>
        </Button>
    </Grid>
</UserControl>