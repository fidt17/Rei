<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:ReiEditor.ViewModels.Windows.Editor"
        xmlns:console="clr-namespace:ReiEditor.Views.Windows.Editor.Console"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ReiEditor.Views.Windows.Editor.ProjectEditorWindow"
        x:DataType="editor:ProjectEditorWindowViewModel"
        Background="{StaticResource Dark_0}"
        Title="Rei Engine"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <editor:ProjectEditorWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, *" RowDefinitions="*, *">
        <console:ConsoleEditorWindow 
            Grid.Column="0" Grid.Row="1"
            Grid.ColumnSpan="2"
            DataContext="{Binding Console}" />
    </Grid>

</Window>