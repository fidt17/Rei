<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviours="clr-namespace:ReiEditor.Views.Behaviours"
             xmlns:buttons="clr-namespace:ReiEditor.Views.Controls.Buttons"
             xmlns:contextMenu="clr-namespace:ReiEditor.Views.Controls.ContextMenu"
             xmlns:hierarchies="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Hierarchies"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Hierarchies.HierarchyNode"
             x:DataType="hierarchies:HierarchyNodeViewModel">
    <Design.DataContext>
        <hierarchies:HierarchyNodeViewModel />
    </Design.DataContext>

    <Border
        x:Name="RootBorder"
        Classes.IsSelected="{Binding Selected.Value}"
        behaviours:TappedBehaviour.Command="{Binding SelectCommand}"
        KeyDown="RootBorder_OnKeyDown"
        Focusable="True"
        Padding="4">

        <Border.Styles>
            <Style Selector="Border#RootBorder">
                <Setter Property="Background" Value="{StaticResource Dark_2}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource Dark_2}" />
            </Style>

            <Style Selector="Border#RootBorder:pointerover">
                <Setter Property="Background" Value="{StaticResource Dark_3}" />
            </Style>

            <Style Selector="Border#RootBorder.IsSelected">
                <Setter Property="Background" Value="{StaticResource Dark_4}" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray_0}" />
            </Style>
        </Border.Styles>

        <Grid ColumnDefinitions="Auto, *">

            <buttons:HorizontalExpandToggle IsChecked="{Binding Expanded.Value}" />

            <Grid Grid.Column="1"
                  HorizontalAlignment="Stretch">
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    Text="{Binding Name}" FontSize="14" />

                <contextMenu:ContextMenuButton
                    ContextMenuData="{Binding ContextMenu}" />
            </Grid>
        </Grid>
    </Border>

</UserControl>