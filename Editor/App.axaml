<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:Editor.Utils"
             x:Class="Editor.App"
             RequestedThemeVariant="Light">
  
    <Application.DataTemplates>
        <utils:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>