{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-debug",
      "displayName": "VS2026 Debug x64",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "REI_BUILD_SANDBOX": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug-rei",
      "configurePreset": "vs2026-debug",
      "configuration": "Debug",
      "targets": ["Rei"]
    },
    {
      "name": "vs2026-debug-sandbox",
      "configurePreset": "vs2026-debug",
      "configuration": "Debug",
      "targets": ["ReiSandbox"]
    }
  ]
}
