<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:drawers="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.AssetMonitorDrawer"
             x:DataType="drawers:AssetMonitorDrawerViewModel">
    <Design.DataContext>
        <drawers:AssetMonitorDrawerViewModel />
    </Design.DataContext>

    <Border Padding="10">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Classes="h4" Text="{Binding AssetName}" />
            <TextBlock Grid.Row="1"
                       Text="{Binding AssetIdLabel}"
                       IsVisible="{Binding ShowAssetIdLabel}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource Gray_2}" />
            <TextBox Grid.Row="2"
                     Text="{Binding FileContent}"
                     Margin="0,6,0,0"
                     IsVisible="{Binding HasFileContentPreview}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     MinHeight="220" />
        </Grid>
    </Border>
</UserControl>
