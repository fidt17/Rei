<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.ProjectSelectionWindowView"
             x:DataType="viewModels:ProjectSelectionWindowViewModel">

    <Design.DataContext>
        <viewModels:ProjectSelectionWindowViewModel />
    </Design.DataContext>

    <TextBlock Text="Welcome to Rei Engine" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
</UserControl>