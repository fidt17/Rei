#ifdef VERTEX
    void main()
    {
       REI_CalculateFragPosAndNormal();
       REI_CalculatePointLightPositions();
    }
#endif

#ifdef FRAGMENT
    uniform float _Shininess;
    uniform sampler2D texture_diffuse1;
    uniform sampler2D texture_specular1;

    void main()
    {    
        vec4 ambient = REI_CalculateAmbientLight();
        vec4 pointLight = REI_CalculatePointLight(_Shininess);

        vec4 texColor = REI_Sample(texture_diffuse1, _TexCoords);
        vec4 specularColor = REI_Sample(texture_specular1, _TexCoords);

        FragColor = (ambient + pointLight * specularColor) * texColor;
    }
#endif
