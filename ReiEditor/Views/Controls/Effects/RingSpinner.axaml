<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:effects="clr-namespace:ReiEditor.Views.Controls.Effects"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Background="black"
             x:Class="ReiEditor.Views.Controls.Effects.RingSpinner">

    <Ellipse x:Name="EllipseSpinner">
        <Ellipse.Styles>
            <Style Selector="Ellipse#EllipseSpinner">
                <Setter Property="Stroke" Value="{Binding $parent[effects:RingSpinner].SpinnerColor}" />
                <Setter Property="StrokeThickness" Value="{Binding $parent[effects:RingSpinner].Thickness}" />
                <Setter Property="StrokeDashArray" Value="{Binding $parent[effects:RingSpinner].StokeDashArray}" />
                
                <Style.Animations>
                    <Animation Duration="0:0:1" IterationCount="INFINITE">
                        <KeyFrame Cue="0%">
                            <Setter Property="RotateTransform.Angle" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="RotateTransform.Angle" Value="360" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Ellipse.Styles>
    </Ellipse>
</UserControl>