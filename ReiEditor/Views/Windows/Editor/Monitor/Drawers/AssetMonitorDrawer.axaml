<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:drawers="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.AssetMonitorDrawer"
             x:DataType="drawers:AssetMonitorDrawerViewModel">
    <Design.DataContext>
        <drawers:AssetMonitorDrawerViewModel />
    </Design.DataContext>

    <Border Padding="10">
        <StackPanel Spacing="6">
            <TextBlock Classes="h4" Text="{Binding AssetName}" />
            <TextBlock Text="{Binding AssetIdLabel}" Foreground="{StaticResource Gray_2}" />
        </StackPanel>
    </Border>
</UserControl>
