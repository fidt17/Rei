<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Monitor.Drawers.Property.Custom"
             xmlns:assets="clr-namespace:ReiEditor.Views.Controls.Assets"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Monitor.Drawers.Property.Custom.AssetPropertyView"
             x:DataType="custom:AssetPropertyViewModel">

    <Design.DataContext>
        <custom:AssetPropertyViewModel />
    </Design.DataContext>

    <Border Padding="1">
        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
            <TextBlock
                Grid.Column="0"
                Width="120"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource Gray_4}"
                Text="{Binding PropertyName.Value}" />

            <assets:AssetPickerView
                Grid.Column="1"
                DataContext="{Binding AssetPicker}" />
        </Grid>
    </Border>
</UserControl>
