#ifdef VERTEX
    layout (location = 0) in vec3 aPos;
    layout (location = 1) in vec3 aNormal;

    uniform mat4 model;
    uniform mat4 view;
    uniform mat4 projection;

    out vec3 FragPos;
    out vec3 Normal;

    void main()
    {
       vec4 vm = view * model * vec4(aPos, 1.0);
       FragPos = vec3(vm);
       gl_Position = projection * vm;
       Normal = mat3(transpose(inverse(view * model))) * aNormal;
    }
#endif

#ifdef FRAGMENT
    in vec3 FragPos;
    in vec3 Normal;

    out vec4 FragColor;

    vec4 CalculateLight()
    {
        vec3 lightPosition = vec3(10,10,10);
        vec4 lightColor = vec4(0.9,0.8,0.7,1);
        float lightStrength = 0.5;
        float shininess = 0.5;

        // diffuse 
        vec3 norm = normalize(Normal);
        vec3 lightDir = normalize(lightPosition - FragPos);
        float diff = max(dot(norm, lightDir), 0.0);
        vec4 diffuse = diff * lightColor;
        
        // specular
        vec3 viewDir = normalize(-FragPos);
        vec3 reflectDir = reflect(-lightDir, norm);  
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
        vec4 specular = spec * lightColor; 

        vec4 result = diffuse + specular;
        result.a = 1;
        return result * lightStrength;
    }

    void main()
    {    
        vec4 light = CalculateLight();

        FragColor = light * vec4(1,1,1,1);
        FragColor.a = 1;
    }
#endif
