#ifdef VERTEX
    void main()
    {
        gl_Position = vec4(aPos.x, aPos.y, 0.0, 1.0); 
        _TexCoords = aTexCoords;
    }
#endif

#ifdef FRAGMENT
    uniform sampler2D _MainTex;
    uniform vec4 _Color;

    float GetOutlineAlpha(vec2 uv)
    {
        const float _OutlineSize = 0.8;

        const float offset = 1.0 / 300.0;
        vec2 offsets[32] = vec2[](
            vec2(1,0),
            vec2(0.9807852804032304,0.19509032201612825),
            vec2(0.9238795325112867,0.3826834323650898), 
            vec2(0.8314696123025452,0.5555702330196022), 
            vec2(0.7071067811865476,0.7071067811865476), 
            vec2(0.5555702330196023,0.8314696123025452), 
            vec2(0.38268343236508984,0.9238795325112867),
            vec2(0.19509032201612833,0.9807852804032304),
            vec2(0,1),               
            vec2(-0.1950903220161282,0.9807852804032304),
            vec2(-0.3826834323650897,0.9238795325112867),
            vec2(-0.555570233019602,0.8314696123025453), 
            vec2(-0.7071067811865475,0.7071067811865476),
            vec2(-0.8314696123025453,0.5555702330196022),
            vec2(-0.9238795325112867,0.3826834323650899),
            vec2(-0.9807852804032304,0.1950903220161286),
            vec2(-1,0),
            vec2(-0.9807852804032304,-0.19509032201612836),
            vec2(-0.9238795325112868,-0.38268343236508967),
            vec2(-0.8314696123025455,-0.555570233019602),
            vec2(-0.7071067811865477,-0.7071067811865475),
            vec2(-0.5555702330196022,-0.8314696123025452),
            vec2(-0.38268343236509034,-0.9238795325112865),
            vec2(-0.19509032201612866,-0.9807852804032303),
            vec2(0,-1),
            vec2(0.1950903220161283,-0.9807852804032304),
            vec2(0.38268343236509,-0.9238795325112866),
            vec2(0.5555702330196018,-0.8314696123025455),
            vec2(0.7071067811865474,-0.7071067811865477),
            vec2(0.8314696123025452,-0.5555702330196022),
            vec2(0.9238795325112865,-0.3826834323650904),
            vec2(0.9807852804032303,-0.19509032201612872)
        );
        
        float a = 0;
        for (int d = 0; d < 32; d++)
        {
            float sampleAlpha = texture2D(_MainTex, uv + offsets[d] * offset * _OutlineSize).a;
            a = max(sampleAlpha, a);
        }

        return a;
    }

    void main()
    {   
        FragColor = REI_Sample(_MainTex);
        float originalAlpha = FragColor.a;

        if (originalAlpha > 0)
        {
            discard;
        }    

        float a = GetOutlineAlpha(_TexCoords);
        FragColor = vec4(_Color.r, _Color.g, _Color.b, max(originalAlpha, a));
    }
#endif
