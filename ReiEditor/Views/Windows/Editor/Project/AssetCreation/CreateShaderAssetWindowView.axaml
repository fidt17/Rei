<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Project.AssetCreation"
        mc:Ignorable="d"
        Width="460"
        Height="280"
        MinWidth="420"
        MinHeight="240"
        x:Class="ReiEditor.Views.Windows.Editor.Project.AssetCreation.CreateShaderAssetWindowView"
        x:DataType="vm:CreateShaderAssetWindowViewModel"
        Title="Create Shader"
        Icon="/Assets/Images/Rei Icon.png"
        Background="{StaticResource Dark_0}"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:CreateShaderAssetWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Text="Create Shader" Classes="h2" />

        <StackPanel Grid.Row="1" Margin="0,16,0,16" Spacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Name" />
                <TextBox Text="{Binding ShaderName}" />
            </StackPanel>

            <TextBlock Foreground="{StaticResource Error}"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorText}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Command="{Binding CreateCommand}" Content="Create" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
