#ifdef VERTEX
    void main()
    {
        REI_CalculateFragPosAndNormal();
        REI_CalculatePointLightPositions();
    }
#endif

#ifdef FRAGMENT
    uniform float _Shininess;
    uniform vec4 _Color;
    uniform sampler2D _MainTex;

    void main()
    {
        vec4 ambient = REI_CalculateAmbientLight();
        vec3 directLight = REI_CalculatePointLight(_Shininess) + REI_CalculateSpotLight(_Shininess);
        vec4 texColor = REI_Sample(_MainTex);

        vec4 baseColor = texColor * _Color;
        FragColor = vec4(baseColor.rgb * (ambient.rgb + directLight), baseColor.a);
    }
#endif
