<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:playmode="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Playmode"
             mc:Ignorable="d"
             x:Class="ReiEditor.Views.Windows.Editor.Playmode.PlaymodePanelView"
             x:DataType="playmode:PlaymodePanelViewModel">
    <Design.DataContext>
        <playmode:PlaymodePanelViewModel />
    </Design.DataContext>

    <Border Classes="InnerContent">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Command="{Binding StartPlaymodeCommand}"
                    Classes="EditorIconButton"
                    ToolTip.Tip="Start (Ctrl+P)"
                    HotKey="Ctrl+P"
                    IsVisible="{Binding !PlayModeActive}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="AutomationProperties.Name" Value="Start" />
                    </Style>
                </Button.Styles>
                <Image Classes="EditorIcon" RenderOptions.BitmapInterpolationMode="HighQuality" Source="/Assets/Icons/Lucide/play.png" />
            </Button>

            <Button Command="{Binding StopPlaymodeCommand}"
                    Classes="EditorIconButton"
                    ToolTip.Tip="Stop (Ctrl+P)"
                    HotKey="Ctrl+P"
                    IsVisible="{Binding PlayModeActive}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="AutomationProperties.Name" Value="Stop" />
                    </Style>
                </Button.Styles>
                <Image Classes="EditorIcon" RenderOptions.BitmapInterpolationMode="HighQuality" Source="/Assets/Icons/Lucide/square.png" />
            </Button>
        </StackPanel>
    </Border>

</UserControl>