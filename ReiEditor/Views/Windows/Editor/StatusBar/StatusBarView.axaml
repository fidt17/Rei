<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:statusBar="clr-namespace:ReiEditor.ViewModels.Windows.Editor.StatusBar"
             xmlns:effects="clr-namespace:ReiEditor.Views.Controls.Effects"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="ReiEditor.Views.Windows.Editor.StatusBar.StatusBarView"
             x:DataType="statusBar:StatusBarViewModel">

    <Design.DataContext>
        <statusBar:StatusBarViewModel />
    </Design.DataContext>

    <Border Classes="Window" VerticalAlignment="Center"
            Margin="2,0, 2,0">
        <StackPanel Orientation="Horizontal"
                    Spacing="10">
            <effects:RingSpinner
                Width="14"
                Height="14"
                Thickness="4"
                StokeDashArray="1"
                SpinnerColor="{StaticResource White}" 
                IsVisible="{Binding ShowStatusBar}" />

            <TextBlock 
                IsVisible="{Binding ShowStatusBar}"
                Classes="h5" Text="{Binding ActiveProcedureText}" />
        </StackPanel>
    </Border>
</UserControl>