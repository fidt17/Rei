<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:ReiEditor.ViewModels.Windows.Editor"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ReiEditor.Views.Windows.Editor.ProjectEditorWindow"
        x:DataType="editor:ProjectEditorWindowViewModel"
        Title="Rei Engine"
        WindowStartupLocation="CenterScreen"
        Width="1000" Height="600">

    <Design.DataContext>
        <editor:ProjectEditorWindowViewModel />
    </Design.DataContext>

    <TextBlock Text="{Binding Project.ProjectName}" Classes="h2" HorizontalAlignment="Center" VerticalAlignment="Center" />

</Window>