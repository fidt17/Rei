in vec3 _FragPos;
in vec3 _Normal;
in vec3 _PointLightPositions[NR_POINT_LIGHTS];
in vec2 _TexCoords;

out vec4 FragColor;

vec4 REI_CalculateAmbientLight()
{
    vec4 ambient = _AmbientLight.Strength * _AmbientLight.Color;
    ambient.a = 1;
    
    return ambient;
} 

float REI_CalculatePointLightAttenuation(float distanceSquared, float range)
{
    if (range <= 0.0) return 0.0;
    float factor = distanceSquared / (range * range);
    float smoothFactor = max(1.0 - factor * factor, 0.0);
    // A finite source radius avoids a singularity when a surface touches the light.
    return (smoothFactor * smoothFactor) / max(distanceSquared, 0.0001);
}

vec3 REI_CalculatePointLight(float shininess)
{
    vec3 total = vec3(0.0);
    for (int i = 0; i < min(_PointLightsCount, NR_POINT_LIGHTS); i++)
    {
        PointLight light = _PointLights[i];
        vec3 offset = _PointLightPositions[i] - _FragPos;
        float distanceSquared = dot(offset, offset);
        float attenuation = REI_CalculatePointLightAttenuation(distanceSquared, light.Range);
        if (attenuation <= 0.0) continue;

        vec3 norm = normalize(_Normal);
        vec3 lightDir = offset * inversesqrt(max(distanceSquared, 0.0001));
        float diff = max(dot(norm, lightDir), 0.0);
        vec3 diffuse = diff * light.Color.rgb;

        vec3 viewDir = normalize(-_FragPos);
        vec3 reflectDir = reflect(-lightDir, norm);
        float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
        vec3 specular = spec * light.Color.rgb;

        total += (diffuse + specular) * (light.Strength * attenuation);
    }

    return total;
}

// Final scene output only. RGB is linear; alpha is coverage and stays unchanged.
uniform float _ExposureMultiplier;
uniform int _ToneMapping;

vec4 REI_ApplyToneMapping(vec4 color)
{
    // Half-float highlights can overflow to infinity; saturate before the curve.
    vec3 exposed = clamp(color.rgb, vec3(0.0), vec3(65504.0)) * _ExposureMultiplier;
    if (_ToneMapping == 1) exposed = exposed / (vec3(1.0) + exposed);
    return vec4(exposed, color.a);
}

vec4 REI_Sample(sampler2D sampler)
{
    return texture(sampler, _TexCoords);
}
