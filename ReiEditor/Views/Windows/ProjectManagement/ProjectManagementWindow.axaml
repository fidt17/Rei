<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:projectManagement="clr-namespace:ReiEditor.ViewModels.Windows.ProjectManagement"
        mc:Ignorable="d"
        x:Class="ReiEditor.Views.Windows.ProjectManagement.ProjectManagementWindow"
        x:DataType="projectManagement:ProjectManagementWindowViewModel"
        WindowStartupLocation="CenterScreen"
        Width="550" Height="450"
        Icon="/Assets/Images/Rei Icon.png">

    <Design.DataContext>
        <projectManagement:ProjectManagementWindowViewModel />
    </Design.DataContext>

    <ContentControl Content="{Binding ActiveTab.ViewModel}" />
</Window>
