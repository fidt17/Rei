#ifdef VERTEX
    layout (location = 0) in vec3 aPos;

    uniform mat4 model;
    uniform mat4 view;
    uniform mat4 projection;

    void main()
    {
        gl_Position = projection * view * model * vec4(aPos, 1.0);
    } 
#endif

#ifdef FRAGMENT
    uniform float _Strength;
    uniform vec4 _Color;

    out vec4 FragColor;

    void main()
    {
        FragColor = _Color * _Strength;
        FragColor.a = 1;
    }
#endif
