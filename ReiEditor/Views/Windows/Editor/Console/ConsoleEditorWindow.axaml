<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:console="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Console"
             mc:Ignorable="d"
             d:DesignWidth="550" d:DesignHeight="200"
             x:Class="ReiEditor.Views.Windows.Editor.Console.ConsoleEditorWindow"
             x:DataType="console:ConsoleEditorWindowViewModel">
    <Design.DataContext>
        <console:ConsoleEditorWindowViewModel />
    </Design.DataContext>

    <Border Classes="Window">
        <Grid RowDefinitions="Auto, *">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Text="Console"
                           VerticalAlignment="Center"
                           Classes="h5" Foreground="white" />

                <Button Grid.Column="2" Command="{Binding ClearConsoleCommand}">
                    Clear
                </Button>
            </Grid>

            <!-- Content -->
            <Border Grid.Row="1" Classes="WindowContent">
                <ScrollViewer x:Name="ConsoleScrollViewer">
                    <ItemsControl
                        ItemsSource="{Binding Logs}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>