<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hierarchy="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Hierarchy"
             mc:Ignorable="d"
             Height="24"
             x:Class="ReiEditor.Views.Windows.Editor.Hierarchy.HierarchyGameEntity"
             x:DataType="hierarchy:HierarchyGameEntityViewModel">
    <Design.DataContext>
        <hierarchy:HierarchyGameEntityViewModel />
    </Design.DataContext>

    <Border Classes="InnerContent"
            Padding="4">
        <TextBlock Text="{Binding Name}" />
    </Border>

</UserControl>