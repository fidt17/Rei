<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="Editor.Views.ProjectManagementWindowView"
             x:DataType="viewModels:ProjectManagementWindowViewModel"
             Width="500" Height="450">

    <Design.DataContext>
        <viewModels:ProjectManagementWindowViewModel />
    </Design.DataContext>
    
    <ContentControl Content="{Binding ActiveTab.ViewModel}" />

</UserControl>