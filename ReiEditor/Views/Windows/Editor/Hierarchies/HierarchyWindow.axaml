<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contextMenu="clr-namespace:ReiEditor.Views.Controls.ContextMenu"
             xmlns:hierarchies="clr-namespace:ReiEditor.ViewModels.Windows.Editor.Hierarchies"
             xmlns:hierarchies1="clr-namespace:ReiEditor.Views.Windows.Editor.Hierarchies"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="450"
             x:Class="ReiEditor.Views.Windows.Editor.Hierarchies.HierarchyWindow"
             x:DataType="hierarchies:HierarchyWindowViewModel">
    <Design.DataContext>
        <hierarchies:HierarchyWindowViewModel />
    </Design.DataContext>

    <Border Classes="Window">
        <Grid RowDefinitions="Auto, *">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hierarchy "
                           VerticalAlignment="Center"
                           Classes="h5" Foreground="white" />

                <TextBlock Text="{Binding SceneName.Value}"
                           VerticalAlignment="Center"
                           Classes="h5" Foreground="white" />
            </StackPanel>

            <!-- Content -->
            <Border Grid.Row="1" 
                    Name="RootBorder"
                    PointerPressed="HierarchyContentBorder_OnPointerPressed"
                    Classes="WindowContent">
                <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="Pointer" FlyoutPresenterClasses="Clear">
                        <contextMenu:ContextMenuView DataContext="{Binding RootContextMenu}" />
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
                <ScrollViewer x:Name="HierarchyScrollViewer"
                              Background="Transparent"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl
                        ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="hierarchies:HierarchyNodeViewModel">
                                <hierarchies1:HierarchyNode />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</UserControl>
